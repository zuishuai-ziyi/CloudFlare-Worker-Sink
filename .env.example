# Sink configuration for self-hosted (Node.js) deployments.
#
# Sink runs as a long-lived Node process (Nitro `node-server` preset). All
# variables below are read at runtime — no separate Cloudflare bindings or
# `DEPLOY_*` placeholders are required.

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Required. Dashboard login password and API password (at least 8 characters;
# keep it stable). When unset, a random value is generated while the app is
# built, so the password silently changes on every rebuild and is not
# recoverable from the build output. Always set it explicitly.
NUXT_SITE_TOKEN=replace-with-a-strong-private-token

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Standard Node.js host/port. Used by `node .output/server/index.mjs`
# (equivalently `pnpm start` or `pnpm preview`). Defaults to `0.0.0.0:3000`
# when unset.
PORT=3000
HOST=0.0.0.0

# Directory used for the local SQLite database (`sink.db`), the file/object
# bucket (`r2/`), and any other Node-platform state. Defaults to `./data`
# relative to the working directory when the process starts. Created on first
# use; persist it across deploys.
NUXT_DATA_DIR=./data

# Set to exactly `true` to allow browser apps on other origins to call
# `/api/**` (CORS). Authentication (site token or Cloudflare Access JWT)
# is still required.
NUXT_API_CORS=false

# ---------------------------------------------------------------------------
# AI (optional)
# ---------------------------------------------------------------------------
# Leave both blank to disable AI features. Related endpoints will respond
# with HTTP 501 until a base URL and API key are configured. The binding
# proxies chat completions to any OpenAI-compatible HTTP endpoint.
NUXT_AI_BASE_URL=
NUXT_AI_API_KEY=
# Model name passed to the upstream provider. Only meaningful when the AI
# binding is enabled above.
NUXT_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# Custom slug/OG prompts. The slug prompt must keep the `{slugRegex}`
# placeholder.
NUXT_AI_PROMPT=
NUXT_AI_OG_PROMPT=

# ---------------------------------------------------------------------------
# Geolocation (optional)
# ---------------------------------------------------------------------------
# Two ways to populate `request.cf` for analytics and country routing:
#
# 1. Reverse proxy injection (recommended for nginx + geoip2). The proxy
#    sends these headers and Sink consumes them directly:
#      x-geo-country, x-geo-region, x-geo-city, x-geo-timezone,
#      x-geo-latitude, x-geo-longitude, x-geo-colo
#    Headers take priority; GeoIP lookup below is skipped when any of
#    them are present.
#
# 2. Server-side MaxMind lookup. Point at a GeoLite2-City `.mmdb` file
#    and Sink resolves the client IP itself. Leave empty to disable
#    this fallback.
#
# When neither path is configured, country/region/city and lat/lon are
# empty and the geo features degrade gracefully.
NUXT_GEOIP_DB=

# ---------------------------------------------------------------------------
# Analytics retention
# ---------------------------------------------------------------------------
# Access logs are kept in the local SQLite `access_logs` table. Values
# <= 0 keep rows forever; positive integers are interpreted as days.
NUXT_ANALYTICS_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
# Daily automatic backups of all links land under `${NUXT_DATA_DIR}/r2/backups/`
# at 00:00 UTC. Set to `true` to disable.
NUXT_DISABLE_AUTO_BACKUP=false

# ---------------------------------------------------------------------------
# Runtime tuning (defaults shown; usually leave alone)
# ---------------------------------------------------------------------------
# Normal redirect status code. 302/307/308 also work. Unknown short codes
# always redirect with HTTP 302.
NUXT_REDIRECT_STATUS_CODE=301
# Legacy KV-cache TTL for resolved links, in seconds. The Node KV shim has no
# edge cache, so this value is accepted for compatibility but ignored; a cached
# link stays valid until its own `expiration` passes.
NUXT_LINK_CACHE_TTL=60
# `true` appends the visitor's query string to the destination URL.
NUXT_REDIRECT_WITH_QUERY=false
# `true` asks browsers not to cache the redirect response.
NUXT_REDIRECT_NO_STORE=false
# `true` keeps custom short-code case (`Docs` and `docs` differ).
NUXT_CASE_SENSITIVE=false
# Max rows returned by analytics list endpoints.
NUXT_LIST_QUERY_LIMIT=500
# `true` drops detected bots from analytics and webhook events.
NUXT_DISABLE_BOT_ACCESS_LOG=false

# ---------------------------------------------------------------------------
# Redirect targets
# ---------------------------------------------------------------------------
# Non-empty URL redirects `/` to it; empty redirects to `/dashboard`.
NUXT_HOME_URL=
# URL for unknown short codes (always HTTP 302).
NUXT_NOT_FOUND_REDIRECT=

# ---------------------------------------------------------------------------
# Cloudflare Access (optional)
# ---------------------------------------------------------------------------
# Only useful when traffic still flows through Cloudflare Access. Set both
# to enable JWT-based dashboard/API authentication in addition to
# `NUXT_SITE_TOKEN`.
NUXT_CF_ACCESS_TEAM_DOMAIN=
NUXT_CF_ACCESS_AUD=

# ---------------------------------------------------------------------------
# Webhooks
# ---------------------------------------------------------------------------
# HTTP(S) endpoint notified on every short-link visit.
NUXT_WEBHOOK_URL=
# Optional signing secret starting with `whsec_`.
NUXT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Safe browsing (optional)
# ---------------------------------------------------------------------------
# DNS-over-HTTPS URL used to flag unsafe destination domains when a link
# has no explicit `unsafe` flag. Example:
# https://family.cloudflare-dns.com/dns-query
NUXT_SAFE_BROWSING_DOH=

# ---------------------------------------------------------------------------
# Public UI overrides (only change defaults)
# ---------------------------------------------------------------------------
# `true` enables demo/preview mode: new links last 5 minutes and cannot be
# edited or deleted. Use only on throwaway public demos.
NUXT_PUBLIC_PREVIEW_MODE=
# Length of auto-generated short codes.
NUXT_PUBLIC_SLUG_DEFAULT_LENGTH=6
# Export page size; import accepts at most half of this per request.
NUXT_PUBLIC_KV_BATCH_LIMIT=50
